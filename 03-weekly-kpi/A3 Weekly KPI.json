      "name": "Fetch Orders Data",
      "credentials": {
        "supabaseApi": {
          "id": "gvR2N3tCExAlWtZ9",
          "name": "Supabase account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "let totalRevenue = 0;\nlet thisWeek = 0;\nlet lastWeek = 0;\n\nconst today = new Date();\n\nfor (const item of $input.all()) {\n  const amount = parseFloat(item.json.amount || 0);\n  const orderDate = new Date(item.json.order_date);\n  \n  // Calculate difference in days\n  const diffTime = Math.abs(today - orderDate);\n  const diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24));\n\n  totalRevenue += amount;\n\n  if (diffDays <= 7) {\n    thisWeek += amount;\n  } else if (diffDays > 7 && diffDays <= 14) {\n    lastWeek += amount;\n  }\n}\n\nreturn [{ \n  json: { \n    total_revenue: totalRevenue,\n    this_week: thisWeek,\n    last_week: lastWeek\n  } \n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        176
      ],
      "id": "0e77478d-2762-48dc-8970-22fe579ee077",
      "name": "Calculate KPIs"
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=You are a data analyst writing a weekly KPI report for the sales team.\n\nHere are the numbers:\nTotal Revenue: {{ $json.total_revenue }}\nThis Week's Revenue: {{ $json.this_week }}\nLast Week's Revenue: {{ $json.last_week }}\nWrite a short, 2-3 sentence commentary on these results. Mention if revenue went up or down compared to last week. Keep it professional and encouraging. Do not use markdown.\n\n",
        "batching": {}
      },
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.9,
      "position": [
        704,
        176
      ],
      "id": "938424e0-e103-4f3b-8841-f425038f9512",
      "name": "AI Write Commentary"
    },
    {
      "parameters": {
        "options": {}
      },
