      "typeVersion": 1.2,
      "position": [
        784,
        400
      ],
      "id": "dd2b85a0-616c-4538-aeaf-eca4ee75cda3",
      "name": "Generate Commentary",
      "credentials": {
        "googlePalmApi": {
          "id": "s9FXxWidlg1dQkGp",
          "name": "Google Gemini(PaLM) Api account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Get the data from previous nodes\nconst data = $('Calculate KPIs').first().json; // The node where we calculated the numbers\nconst aiCommentary = $input.first().json.text; // The AI's text\n\n// Format the numbers with commas\nconst totalRev = Number(data.total_revenue).toLocaleString();\nconst thisWeek = Number(data.this_week).toLocaleString();\nconst lastWeek = Number(data.last_week).toLocaleString();\n\n// Build the final report\nconst finalReport = `\nWEEKLY KPI REPORT\n-----------------\nTotal Revenue: $${totalRev}\nThis Week: $${thisWeek}\nLast Week: $${lastWeek}\n\nCOMMENTARY:\n${aiCommentary}\n`;\n\nreturn [{ json: { report: finalReport } }];"
      },
      "type": "n8n-nodes-base.code",
